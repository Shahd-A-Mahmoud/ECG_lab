          </property>
          <property name="styleSheet">
           <string notr="true">/* Customize Horizontal Slider */
QSlider::groove:horizontal {
    background: #d2d1d1;  /* Background color */
    height: 10px;          /* Groove height */
    border-radius: 5px;
}

QSlider::handle:horizontal {
    background: #C30000;  /* Handle (thumb) color */
    border: none;
    width: 20px;          /* Handle width */
    height: 20px;         /* Handle height */
    margin: -5px 0;       /* Adjust position to be centered */
    border-radius: 10px;  /* Circular handle */
}

QSlider::handle:horizontal:hover {
    background: #A00000;  /* Darker color on hover */
}

QSlider::add-page:horizontal {
    background: #d2d1d1; /* Right side of the slider */
}

QSlider::sub-page:horizontal {
    background: #C30000; /* Left side of the slider */
    border-radius: 5px;
}
</string>
          </property>
