    color: #ce0000;
    font-size: 14px;
    font-family: &quot;Poppins&quot;;
    font-weight: bold;
    border-radius: 15px;
    padding: 5px;
    /* Use qproperty-alignment to center the displayed text */
    qproperty-alignment: 'AlignCenter';
}

QComboBox::drop-down {
    border: none;
    background-color: #ce0000;
    width: 25px;
    border-radius: 15px;
}

QComboBox QAbstractItemView {
    background-color:#ce0000;
    color:#ffcdd2;
    selection-background-color: #d2d1d1;
    selection-color: #ce0000;
    border-radius: 10px;
    /* Center items in the dropdown */
    text-align: center;
}

/* Optional: Center text in each dropdown item */
QComboBox::item {
    text-align: center;
}
</string>
